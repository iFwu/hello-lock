<Window x:Class="HelloLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelloLock"
        Icon="Assets/HelloLock.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#24000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid>
        <Border x:Name="LockCard"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="420" MinHeight="248"
                Background="#F21C1F24" BorderBrush="#33FFFFFF"
                BorderThickness="1" CornerRadius="8" Padding="40,34">
            <StackPanel VerticalAlignment="Center">
                <Image Source="Assets/HelloLock.png" Width="68" Height="68"
                       Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="HelloLock" Foreground="#99FFFFFF"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TitleText"
                           Foreground="White" FontSize="26" FontWeight="SemiBold"
                           Margin="0,6,0,0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="HintText"
                           Foreground="#BFFFFFFF" FontSize="14" Margin="0,8,0,24"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <Button x:Name="UnlockButton"
                        MinWidth="220" Height="42" Padding="20,8"
                        Background="#FF2F81F7" Foreground="White"
                        BorderBrush="#FF2F81F7" BorderThickness="1"
                        FontSize="14" FontWeight="SemiBold"
                        Click="OnUnlockClick" HorizontalAlignment="Center" Cursor="Hand"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#FFFF7B72" FontSize="13"
                           Margin="0,16,0,0" HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
