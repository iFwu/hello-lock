<Window x:Class="HelloLock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelloLock settings"
        Icon="Assets/HelloLock.ico"
        Width="520" Height="430"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFF6F7F9"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF171A1F"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/HelloLock.png" Width="38" Height="38"
                   Stretch="Uniform" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="HelloLock" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" Margin="0,4,0,0"
                           Foreground="#FF656B75" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE1E4E8"
                BorderThickness="1" CornerRadius="8" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="IdleLabel" VerticalAlignment="Center" FontSize="14"/>
                <ComboBox x:Name="IdleCombo" Grid.Column="1" DisplayMemberPath="Label"
                          SelectedValuePath="Minutes"/>

                <TextBlock x:Name="StartupLabel" Grid.Row="2" VerticalAlignment="Center"
                           FontSize="14"/>
                <CheckBox x:Name="StartupCheck" Grid.Row="2" Grid.Column="1"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          Checked="OnGuardToggled" Unchecked="OnGuardToggled"/>

                <TextBlock x:Name="LanguageLabel" Grid.Row="4" VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="LanguageCombo" Grid.Row="4" Grid.Column="1"
                          DisplayMemberPath="Label" SelectedValuePath="Language"
                          SelectionChanged="OnLanguageSelectionChanged"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="#FF5B6470" FontSize="13"/>
                <TextBlock x:Name="VersionText" Margin="0,3,0,0"
                           Foreground="#FF7A828D" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Click="OnCancel" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Click="OnSave" IsDefault="True"
                        Background="#FF1F6FEB" Foreground="White" BorderBrush="#FF1F6FEB"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
