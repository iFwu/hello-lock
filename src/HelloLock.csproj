<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 才能拿到 Windows.Security.Credentials.UI (Windows Hello) 的 WinRT 投影 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HelloLock</AssemblyName>
    <RootNamespace>HelloLock</RootNamespace>
    <Version>0.1.3</Version>
    <Authors>niceSprite</Authors>
    <Description>Transparent application-level Windows lock with Windows Hello verification.</Description>
    <RepositoryUrl>https://github.com/iFwu/hello-lock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\HelloLock.ico</ApplicationIcon>
    <!-- Deployment mode is selected by CI/CLI. WPF single-file bundling caused
         native DLL load failures on one tested Windows machine. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\HelloLock.ico" />
    <Resource Include="Assets\HelloLock.png" />
    <Resource Include="Assets\HelloLockTray.ico" />
  </ItemGroup>

</Project>
